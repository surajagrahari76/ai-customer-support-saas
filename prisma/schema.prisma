generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Settings {
  id           String   @id @default(cuid())
  ownerId      String   @unique
  businessName String
  supportEmail String
  knowledge    String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
